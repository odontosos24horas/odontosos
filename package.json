{
  "name": "odontosos",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.4.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "precommit": "pnpm typecheck",
    "commit": "cz",
    "prepare": "husky install",
    "postinstall": "husky install",
    "prepush": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "7.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
